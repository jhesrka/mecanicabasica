# Driver de Base de Datos: 'mysql' o 'pgsql'
DB_CONNECTION=mysql

# Configuración MySQL (Laragon / XAMPP)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=taller_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Configuración PostgreSQL
PGSQL_HOST=localhost
PGSQL_PORT=5432
PGSQL_DATABASE=taller_db
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=postgres

